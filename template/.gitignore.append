# cclv-specboot patterns (merged here by bin/install.sh)

# Env files (never commit secrets)
# .env stays committed: Lovable Cloud writes public values there (Supabase URL + publishable key),
# and Lovable's docs say not to ignore it. Personal values go in .env.local.
.env.local
.env.*.local

# Build artifacts
dist/
build/
.next/
out/

# Node
node_modules/
.npm/
.pnpm-store/

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# .lovable/ is committed by Lovable (project.json + Plan-mode archives) — do not ignore it

# Local Supabase (if using CLI)
supabase/.temp/
supabase/.branches/

# Test artifacts
coverage/
playwright-report/
test-results/

# Misc
.cache/
*.local
