# {{PROJECT_NAME}} — environment variables (reference list, no values)
#
# On Lovable Cloud, Lovable writes the public values below into the committed .env.
# Don't copy this file over your env: an empty VITE_SUPABASE_URL= in .env.local
# overrides the committed value and breaks the app. Put only personal overrides in
# .env.local (gitignored).
#
# Backend-only secrets never go in any .env file. They live in:
#   Lovable editor → Settings → Secrets (Lovable Cloud), or
#   Supabase dashboard → Edge Functions → Secrets (your own Supabase project).

# === Public (written by Lovable Cloud into .env) ===

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# === Backend secrets (set in Lovable Secrets or Supabase, NOT here) ===

# OPENAI_API_KEY=...
# STRIPE_SECRET_KEY=...
# (add as LV prompts require them)
